#
# system.prop for mt6592 generic
#

# WiFi
wifi.interface=wlan0
wifi.tethering.interface=ap0
wifi.direct.interface=p2p0

# LCD density
ro.sf.lcd_density=220
# gralloc.mt6592 HW_FB handles cannot cross processes on Pie (see FramebufferSurface)
ro.sf.no_hw_fb_usage=true

# Graphics
ro.opengles.version=131072

# Graphics: do not run the persistent asset atlas.
# The stock ROM never ran it (its Zygote preload is disabled, which gates
# AssetAtlasService in SystemServer). MTK's Mali cannot import the atlas
# buffer: hwui AssetAtlas::init -> eglCreateImageKHR -> libMali shim
# dereferences NULL after GpuAuxIsSupportFormat() reports the format
# unsupported, taking SystemUI down in a restart loop.
# SystemServer reads this via SystemProperties.getBoolean("config.disable_atlas").
config.disable_atlas=1

qemu.hw.mainkeys=1

# Load sensors.hulkbuster.so (the MTK blob + BMG160 gyroscope wrapper) instead
# of sensors.mt6592.so; hw_get_module checks ro.hardware.<class> first.
ro.hardware.sensors=hulkbuster

# libMali crashes in system_server's screen-off ColorFade (eglMakeCurrent);
# skip the animation (frameworks/base patch)
ro.config.disable_color_fade=true

# Triple-buffer app surfaces (Pie defaults to double buffering)
ro.sf.disable_triple_buffer=0
# The MTK audio.primary blob crashes in its legacy dump(); skip it on dumpsys
ro.audio.skip_legacy_dump=true

# HWC1 / Mali-450 graphics, as on other HWC1 devices (exynos7420):
# latch app buffers without waiting for their GPU fences, run the top app's
# UI and render threads SCHED_FIFO, and skip buffer-age partial redraws.
debug.sf.latch_unsignaled=1
sys.use_fifo_ui=1
debug.hwui.use_buffer_age=false

# The rear camera borrows the OV8858 feature table for its AF modes; hide
# the upscaled picture sizes above the 5 MP S5K4E1GA.
ro.vendor.camera0.max_picture_size=2560x1920

# Low-RAM tuning (from the galaxys2-common Pie/21 trees):
# fewer GCs in the foreground app, no GL driver preload in zygote (less RAM
# per app process), and start background services one at a time.
dalvik.vm.foreground-heap-growth-multiplier=2.0
ro.zygote.disable_gl_preload=true
ro.config.max_starting_bg=1

# Notification -> app launch: use the normal window transition instead of
# SystemUI's per-frame remote animation, which stutters on HWC1/Mali-450
# (frameworks/base patch adds the switch).
persist.sys.notif_launch_anim=false
# Front camera (GC2235) has no flash LED.
ro.vendor.camera1.no_flash=true
