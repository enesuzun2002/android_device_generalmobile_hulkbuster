# Mali GPU and MTK vsync nodes (gpu_device exists in the platform policy)
/dev/mali         u:object_r:gpu_device:s0
/dev/mtkfb_vsync  u:object_r:gpu_device:s0

# Wifi device
/dev/wmtWifi      u:object_r:wmtWifi_device:s0

# MTK hwmsen sensor framework (used by the native sensors HAL)
/dev/hwmsensor    u:object_r:hwmsensor_device:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.sensors@1\.0-service\.hulkbuster u:object_r:hal_sensors_default_exec:s0

# Native lights/power HALs (lights/, power/)
/(vendor|system/vendor)/bin/hw/android\.hardware\.light@2\.0-service\.hulkbuster u:object_r:hal_light_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.power@1\.0-service\.hulkbuster u:object_r:hal_power_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.thermal@1\.0-service\.hulkbuster u:object_r:hal_thermal_default_exec:s0
