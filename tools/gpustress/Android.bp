// GPU stress/validation tool for DVFS work (not installed by default).
cc_binary {
    name: "gpustress",
    srcs: ["gpustress.cpp"],
    shared_libs: ["libEGL", "libGLESv2", "liblog"],
    cflags: ["-Wall", "-Werror"],
}

// Memory/swap validation: fills memory with verifiable patterns from several
// threads to push pages through zram, then checks every page.
cc_binary {
    name: "memstress",
    srcs: ["memstress.cpp"],
    cflags: ["-Wall", "-Werror"],
}

// Physical register peek/poke through /dev/mem (DVFS bring-up only).
cc_binary {
    name: "physreg",
    srcs: ["physreg.cpp"],
    cflags: ["-Wall", "-Werror"],
}

// Set/get audio HAL parameters (MTK MusicPlus/BesLoudness tuning).
cc_binary {
    name: "audioparam",
    srcs: ["audioparam.cpp"],
    shared_libs: ["libaudioclient", "libutils", "libbinder"],
    cflags: ["-Wall", "-Werror"],
}
