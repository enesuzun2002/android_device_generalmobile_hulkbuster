// Standalone prototype: decode H.264 Annex-B with MTK HW decoder by calling
// libvcodecdrv.so directly (dlopen), no OMX.
cc_binary {
    name: "vdectest",
    srcs: ["vdectest.cpp"],
    include_dirs: ["device/generalmobile/hulkbuster/media/hulkavcdec"],
    shared_libs: ["liblog"],
    cflags: ["-Wall", "-Wno-unused-parameter"],
}
