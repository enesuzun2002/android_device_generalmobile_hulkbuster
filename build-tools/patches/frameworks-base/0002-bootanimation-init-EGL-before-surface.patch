From b7021ebc13424edcc58556705fee9e347aa721df Mon Sep 17 00:00:00 2001
From: hulkbuster-build <build@localhost>
Date: Sun, 18 Oct 2026 06:12:39 +0000
Subject: [PATCH] bootanimation: init EGL before the surface, match config
 visual, log errors

The old code created the SF surface first (hardcoded RGB_565), then
initialised EGL without checking any return value; when
eglCreateWindowSurface/eglMakeCurrent failed the render thread silently
died (backlit black screen). Now:
- EGL display/config is brought up first (with error logs + EGL vendor)
- attribs include EGL_SURFACE_TYPE/EGL_WINDOW_BIT and
  EGL_RENDERABLE_TYPE/EGL_OPENGL_ES2_BIT
- the surface is created with the chosen config's EGL_NATIVE_VISUAL_ID
  (falls back to RGB_565, with one retry before giving up)
- eglSwapBuffers failures are logged once in playAnimation()
Also enables finding the gralloc/ION failure class
(EGL_BAD_ALLOC -> '[MALI][Gralloc-ERROR] ion_open failed') the device
actually had.

Change-Id: Ib2994a559e3fc791c8ba6f10accbadaa06d2c2d7
Signed-off-by: enesuzun2002 <emurat.uzun@gmail.com>
---
 cmds/bootanimation/BootAnimation.cpp | 128 +++++++++++++++++++++++++++++------
 1 file changed, 109 insertions(+), 19 deletions(-)

diff --git a/cmds/bootanimation/BootAnimation.cpp b/cmds/bootanimation/BootAnimation.cpp
index 10fabcf..b345d1d 100644
--- a/cmds/bootanimation/BootAnimation.cpp
+++ b/cmds/bootanimation/BootAnimation.cpp
@@ -268,15 +268,32 @@ status_t BootAnimation::readyToRun() {
     if (status)
         return -1;
 
-    // create the native surface
-    sp<SurfaceControl> control = session()->createSurface(String8("BootAnimation"),
-            dinfo.w, dinfo.h, PIXEL_FORMAT_RGB_565);
+    // Initialize EGL *before* creating the native surface, so the window format
+    // can be matched to the config the driver actually hands us. Hardcoding
+    // PIXEL_FORMAT_RGB_565 for the surface while asking for an 8/8/8 config makes
+    // eglCreateWindowSurface fail with EGL_BAD_MATCH on drivers that validate the
+    // pair, which is a silent black screen with no boot animation at all.
+    EGLint w, h;
+    EGLint numConfigs;
+    EGLConfig config;
+    EGLSurface surface;
+    EGLContext context;
 
-    SurfaceComposerClient::openGlobalTransaction();
-    control->setLayer(0x40000000);
-    SurfaceComposerClient::closeGlobalTransaction();
+    EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (display == EGL_NO_DISPLAY) {
+        ALOGE("readyToRun: eglGetDisplay failed (err=0x%x)", eglGetError());
+        return NO_INIT;
+    }
 
-    sp<Surface> s = control->getSurface();
+    if (eglInitialize(display, 0, 0) == EGL_FALSE) {
+        ALOGE("readyToRun: eglInitialize failed (err=0x%x)", eglGetError());
+        return NO_INIT;
+    }
+    const char* eglVendor = eglQueryString(display, EGL_VENDOR);
+    const char* eglVersion = eglQueryString(display, EGL_VERSION);
+    ALOGI("readyToRun: EGL vendor=%s version=%s display=%dx%d",
+            eglVendor ? eglVendor : "?", eglVersion ? eglVersion : "?",
+            (int)dinfo.w, (int)dinfo.h);
 
     // initialize opengl and egl
     const EGLint attribs[] = {
@@ -284,25 +301,91 @@ status_t BootAnimation::readyToRun() {
             EGL_GREEN_SIZE, 8,
             EGL_BLUE_SIZE,  8,
             EGL_DEPTH_SIZE, 0,
+            EGL_SURFACE_TYPE,    EGL_WINDOW_BIT,
+            EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
             EGL_NONE
     };
-    EGLint w, h;
-    EGLint numConfigs;
-    EGLConfig config;
-    EGLSurface surface;
-    EGLContext context;
+    config = NULL;
+    numConfigs = 0;
+    if (eglChooseConfig(display, attribs, &config, 1, &numConfigs) == EGL_FALSE
+            || numConfigs < 1) {
+        ALOGE("readyToRun: eglChooseConfig(8/8/8, window, ES2) failed: err=0x%x numConfigs=%d",
+                eglGetError(), numConfigs);
+        // Be defensive: without a config every later call fails and we end up
+        // with a backlit black screen. Fall back to the most permissive window
+        // config the driver offers rather than giving up.
+        const EGLint fallbackAttribs[] = {
+                EGL_SURFACE_TYPE,    EGL_WINDOW_BIT,
+                EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+                EGL_NONE
+        };
+        config = NULL;
+        numConfigs = 0;
+        if (eglChooseConfig(display, fallbackAttribs, &config, 1, &numConfigs) == EGL_FALSE
+                || numConfigs < 1) {
+            ALOGE("readyToRun: eglChooseConfig(fallback) failed: err=0x%x numConfigs=%d",
+                    eglGetError(), numConfigs);
+            return NO_INIT;
+        }
+    }
 
-    EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    // Match the surface to the config's native visual (usually RGBA_8888/RGBX_8888
+    // on Mali). Fall back to RGB_565 if the driver does not report one.
+    EGLint visualFormat = 0;
+    int surfaceFormat = PIXEL_FORMAT_RGB_565;
+    if (eglGetConfigAttrib(display, config, EGL_NATIVE_VISUAL_ID, &visualFormat) == EGL_TRUE
+            && visualFormat > 0) {
+        surfaceFormat = visualFormat;
+    }
+    ALOGI("readyToRun: config native visual=0x%x, surface format=0x%x",
+            visualFormat, surfaceFormat);
+
+    // create the native surface
+    sp<SurfaceControl> control = session()->createSurface(String8("BootAnimation"),
+            dinfo.w, dinfo.h, surfaceFormat);
+
+    SurfaceComposerClient::openGlobalTransaction();
+    control->setLayer(0x40000000);
+    SurfaceComposerClient::closeGlobalTransaction();
+
+    sp<Surface> s = control->getSurface();
 
-    eglInitialize(display, 0, 0);
-    eglChooseConfig(display, attribs, &config, 1, &numConfigs);
     surface = eglCreateWindowSurface(display, config, s.get(), NULL);
+    if (surface == EGL_NO_SURFACE) {
+        ALOGE("readyToRun: eglCreateWindowSurface(format=0x%x) failed: err=0x%x",
+                surfaceFormat, eglGetError());
+        if (surfaceFormat != PIXEL_FORMAT_RGB_565) {
+            // Retry once with the legacy format before giving up.
+            ALOGI("readyToRun: retrying with PIXEL_FORMAT_RGB_565");
+            control = session()->createSurface(String8("BootAnimation"),
+                    dinfo.w, dinfo.h, PIXEL_FORMAT_RGB_565);
+            SurfaceComposerClient::openGlobalTransaction();
+            control->setLayer(0x40000000);
+            SurfaceComposerClient::closeGlobalTransaction();
+            s = control->getSurface();
+            surface = eglCreateWindowSurface(display, config, s.get(), NULL);
+        }
+        if (surface == EGL_NO_SURFACE) {
+            ALOGE("readyToRun: eglCreateWindowSurface retry failed: err=0x%x", eglGetError());
+            return NO_INIT;
+        }
+    }
     context = eglCreateContext(display, config, NULL, NULL);
-    eglQuerySurface(display, surface, EGL_WIDTH, &w);
-    eglQuerySurface(display, surface, EGL_HEIGHT, &h);
+    if (context == EGL_NO_CONTEXT) {
+        ALOGE("readyToRun: eglCreateContext failed: err=0x%x", eglGetError());
+        return NO_INIT;
+    }
+    if (eglQuerySurface(display, surface, EGL_WIDTH, &w) == EGL_FALSE
+            || eglQuerySurface(display, surface, EGL_HEIGHT, &h) == EGL_FALSE) {
+        ALOGE("readyToRun: eglQuerySurface failed: err=0x%x", eglGetError());
+        w = dinfo.w;
+        h = dinfo.h;
+    }
 
-    if (eglMakeCurrent(display, surface, surface, context) == EGL_FALSE)
+    if (eglMakeCurrent(display, surface, surface, context) == EGL_FALSE) {
+        ALOGE("readyToRun: eglMakeCurrent failed: err=0x%x", eglGetError());
         return NO_INIT;
+    }
 
     mDisplay = display;
     mContext = context;
@@ -943,7 +1026,14 @@ bool BootAnimation::playAnimation(const Animation& animation)
                     drawClock(animation.clockFont, part.clockPosX, part.clockPosY);
                 }
 
-                eglSwapBuffers(mDisplay, mSurface);
+                if (eglSwapBuffers(mDisplay, mSurface) == EGL_FALSE) {
+                    // Log once: a failing swap means nothing is ever presented,
+                    // which is otherwise indistinguishable from a black frame.
+                    static bool swapErrorLogged = false;
+                    ALOGE_IF(!swapErrorLogged, "playAnimation: eglSwapBuffers failed: err=0x%x",
+                            eglGetError());
+                    swapErrorLogged = true;
+                }
 
                 nsecs_t now = systemTime();
                 nsecs_t delay = frameDuration - (now - lastFrame);
-- 
2.7.4

