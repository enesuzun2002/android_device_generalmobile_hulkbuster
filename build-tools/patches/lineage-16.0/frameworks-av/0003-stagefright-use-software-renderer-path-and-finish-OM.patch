From 0c14a90c9fcaf58d31283dfffe484797fb238034 Mon Sep 17 00:00:00 2001
From: enesuzun2002 <emurat.uzun@gmail.com>
Date: Wed, 4 Nov 2026 02:07:18 +0300
Subject: [PATCH 3/4] stagefright: use software renderer path and finish
 OMX.hulk.h264.decoder for MT6592 hardware decode

Change-Id: Iba61b2ed411fb205acec87ecae09805ff220821d
---
 media/libstagefright/ACodec.cpp               |  3 +-
 media/libstagefright/MediaCodec.cpp           |  3 +-
 .../codecs/hulkavcdec/SoftHulkAVCDec.cpp      | 31 +++++++++++++++++--
 .../codecs/hulkavcdec/SoftHulkAVCDec.h        |  2 ++
 4 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/media/libstagefright/ACodec.cpp b/media/libstagefright/ACodec.cpp
index 014dfa9..64132f8 100644
--- a/media/libstagefright/ACodec.cpp
+++ b/media/libstagefright/ACodec.cpp
@@ -2020,7 +2020,8 @@ status_t ACodec::configureCodec(
     if (mIsVideo || mIsImage) {
         // determine need for software renderer
         bool usingSwRenderer = false;
-        if (haveNativeWindow && mComponentName.startsWith("OMX.google.")) {
+        if (haveNativeWindow && (mComponentName.startsWith("OMX.google.")
+                || mComponentName.startsWith("OMX.hulk."))) {
             usingSwRenderer = true;
             haveNativeWindow = false;
             (void)setPortMode(kPortIndexOutput, IOMX::kPortModePresetByteBuffer);
diff --git a/media/libstagefright/MediaCodec.cpp b/media/libstagefright/MediaCodec.cpp
index cd1d24b..eee5005 100644
--- a/media/libstagefright/MediaCodec.cpp
+++ b/media/libstagefright/MediaCodec.cpp
@@ -1989,7 +1989,8 @@ void MediaCodec::onMessageReceived(const sp<AMessage> &msg) {
                     }
 
                     const char *owner = mCodecInfo->getOwnerName();
-                    if (mComponentName.startsWith("OMX.google.")
+                    if ((mComponentName.startsWith("OMX.google.")
+                                || mComponentName.startsWith("OMX.hulk."))
                             && (owner == nullptr || strncmp(owner, "default", 8) == 0)) {
                         mFlags |= kFlagUsesSoftwareRenderer;
                     } else {
diff --git a/media/libstagefright/codecs/hulkavcdec/SoftHulkAVCDec.cpp b/media/libstagefright/codecs/hulkavcdec/SoftHulkAVCDec.cpp
index cc35e7a..9940782 100644
--- a/media/libstagefright/codecs/hulkavcdec/SoftHulkAVCDec.cpp
+++ b/media/libstagefright/codecs/hulkavcdec/SoftHulkAVCDec.cpp
@@ -23,9 +23,13 @@
 #include <stdio.h>
 #include <pthread.h>
 #include <string.h>
+#include <time.h>
 
 namespace android {
 
+static double nowSec() { timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec + t.tv_nsec * 1e-9; }
+static double gTDec, gTWait, gTDet; static unsigned gN;
+
 #define componentName "video_decoder.avc"
 #define codingType    OMX_VIDEO_CodingAVC
 
@@ -212,7 +216,7 @@ SoftHulkAVC::SoftHulkAVC(
       mSpsW(0), mSpsH(0), mSpsCodedW(0), mSpsCodedH(0), mLastTs(0),
       mReceivedEOS(false), mEosFlushed(false), mSignalledError(false),
       mNeedReinit(false), mNewW(0), mNewH(0), mFramesOut(0), mDecodeErrors(0),
-      mWExit(false), mGen(0), mDumpFile(NULL), mDumpLeft(0) {
+      mWExit(false), mGen(0), mDumpFile(NULL), mDumpLeft(0), mDumpIn(NULL), mInCount(0), mDecCount(0) {
     memset(&mBs, 0, sizeof(mBs));
     memset(&mJob, 0, sizeof(mJob));
     initPorts(
@@ -225,6 +229,8 @@ SoftHulkAVC::SoftHulkAVC(
         mDumpLeft = atoi(v);
         if (mDumpLeft > 0) mDumpFile = fopen("/data/local/tmp/hulkdump.yuv", "wb");
         if (!mDumpFile) mDumpLeft = 0;
+        property_get("debug.hulk.dumpin", v, "0");
+        if (atoi(v) > 0) mDumpIn = fopen("/data/local/tmp/hulkin.h264", "wb");
     }
     mWorker = std::thread(&SoftHulkAVC::workerLoop, this);
 }
@@ -240,6 +246,7 @@ SoftHulkAVC::~SoftHulkAVC() {
     destroyDecoder();
     freePool();
     if (mDumpFile) fclose(mDumpFile);
+    if (mDumpIn) fclose(mDumpIn);
     if (mBsAlloc) {
         gDrv.free(&mBs, sizeof(mBs));
         mBsAlloc = false;
@@ -281,11 +288,14 @@ void SoftHulkAVC::workerLoop() {
         if (j.gen == mGen.load()) {
             uint8_t *dst = hdr->pBuffer + hdr->nOffset;
             size_t sizeY = (size_t)j.outW * j.outH;
+            double td = nowSec();
             hulkDetileI420((const uint8_t *)mFbs[j.idx]->mem.alignVa, j.stride, j.sliceH, j.w, j.h,
                            dst, j.outW, dst + sizeY, dst + sizeY + sizeY / 4, j.outW / 2);
+            gTDet += nowSec() - td;
         } else {
             hdr->nFilledLen = 0;
             hdr->nTimeStamp = 0;
+            ALOGW("dropping stale frame (gen %u != %u)", j.gen, mGen.load());
         }
         {
             std::lock_guard<std::mutex> fl(mFbLock);
@@ -503,17 +513,23 @@ bool SoftHulkAVC::decodeAu(const uint8_t *au, size_t len) {
         std::lock_guard<std::mutex> fl(mFbLock);
         if (!mFree.empty()) { idx = mFree.back(); mFree.pop_back(); }
     }
-    if (idx >= 0) mFbs[idx]->released = false;
+    if (idx >= 0) mFbs[idx]->released = false; else ALOGW("no free fb for decode");
 
     memcpy(mBs.alignVa, au, len);
     gDrv.flush(&mBs, sizeof(ValMem), 1);
     Bs bs = { (uint32_t)mBs.alignVa, mBs.alignMva, (uint32_t)len, (uint32_t)mBs.alignVa,
               (uint32_t)mBs.alignVa + (uint32_t)len, 0, (uint32_t)mBs.alignVa, 0 };
+    if (mDumpIn) { fwrite(au, 1, len, mDumpIn); fflush(mDumpIn); }
+    double t0 = nowSec();
     int rc = gDrv.decode(mH, &bs, idx >= 0 ? &mFbs[idx]->fb : NULL);
+    gTDec += nowSec() - t0;
     if (rc != 0) {
         if ((mDecodeErrors++ & 63) == 0) ALOGW("decode returned %d (count %u)", rc, mDecodeErrors);
     }
+    size_t before = mPending.size();
+    (void)before;
     drain();
+    ALOGV("decode rc=%d len=%zu pending=%zu", rc, len, mPending.size());
     return rc == 0;
 }
 
@@ -585,10 +601,12 @@ SoftHulkAVC::Result SoftHulkAVC::processInput(OMX_BUFFERHEADERTYPE *hdr) {
     bool config = hdr->nFlags & OMX_BUFFERFLAG_CODECCONFIG;
     if (eos) mReceivedEOS = true;
     ALOGV("input len=%zu flags=0x%x ts=%lld pending=%zu", len, hdr->nFlags, (long long)hdr->nTimeStamp, mPending.size());
-    if (eos) ALOGI("EOS input len=%zu out=%u", len, mFramesOut);
+    if (eos) ALOGI("EOS input len=%zu out=%u inputs=%u decoded=%u", len, mFramesOut, mInCount, mDecCount);
 
     NalScan s;
     if (len > 0) s = scanNals(data, len);
+    mInCount++;
+    if (len > 0 && !config && !s.hasSlice) ALOGW("input #%u len=%zu flags=0x%x has no slice NAL (first bytes %02x %02x %02x %02x %02x)", mInCount, len, hdr->nFlags, data[0], data[1], data[2], data[3], data[4]);
 
     // Resolution handling
     if (s.spsOk) {
@@ -647,6 +665,7 @@ SoftHulkAVC::Result SoftHulkAVC::processInput(OMX_BUFFERHEADERTYPE *hdr) {
     }
 
     mTs.insert(hdr->nTimeStamp);
+    mDecCount++;
     if (!decodeAu(au, auLen)) {
         // the driver rejected the unit; forget its timestamp
         auto it = mTs.find(hdr->nTimeStamp);
@@ -690,7 +709,13 @@ bool SoftHulkAVC::deliverFrame(List<BufferInfo *> &outQ) {
         mUpdateColorAspects = false;
     }
 
+    double tw = nowSec();
     waitWorkerIdle();
+    gTWait += nowSec() - tw;
+    if (++gN % 60 == 0) {
+        ALOGV("avg ms/frame: decode %.1f waitWorker %.1f detile %.1f", gTDec * 1000 / 60, gTWait * 1000 / 60, gTDet * 1000 / 60);
+        gTDec = gTWait = gTDet = 0;
+    }
     {
         std::lock_guard<std::mutex> l(mWMutex);
         mJob.valid = true;
diff --git a/media/libstagefright/codecs/hulkavcdec/SoftHulkAVCDec.h b/media/libstagefright/codecs/hulkavcdec/SoftHulkAVCDec.h
index f0f36ac..ada6c1b 100644
--- a/media/libstagefright/codecs/hulkavcdec/SoftHulkAVCDec.h
+++ b/media/libstagefright/codecs/hulkavcdec/SoftHulkAVCDec.h
@@ -109,6 +109,8 @@ private:
     std::atomic<uint32_t> mGen;
     FILE *mDumpFile;
     int mDumpLeft;
+    FILE *mDumpIn;
+    unsigned mInCount, mDecCount;
 
     OMX_ERRORTYPE sendCommand(OMX_COMMANDTYPE cmd, OMX_U32 param, OMX_PTR data);
 
-- 
2.56.0

