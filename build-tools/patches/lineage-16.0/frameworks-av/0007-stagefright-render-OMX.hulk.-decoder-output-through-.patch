From a6e7e4def4f71c0a85efdc0742456edf8100f1ac Mon Sep 17 00:00:00 2001
From: enesuzun2002 <emurat.uzun@gmail.com>
Date: Wed, 4 Nov 2026 12:03:07 +0300
Subject: [PATCH 7/7] stagefright: render OMX.hulk. decoder output through the
 native window

Change-Id: I6dc12aac332229cf57ccd75f67a48f9a8b17d8c7
---
 media/libstagefright/ACodec.cpp     | 3 +--
 media/libstagefright/MediaCodec.cpp | 3 +--
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/media/libstagefright/ACodec.cpp b/media/libstagefright/ACodec.cpp
index 64132f8..014dfa9 100644
--- a/media/libstagefright/ACodec.cpp
+++ b/media/libstagefright/ACodec.cpp
@@ -2020,8 +2020,7 @@ status_t ACodec::configureCodec(
     if (mIsVideo || mIsImage) {
         // determine need for software renderer
         bool usingSwRenderer = false;
-        if (haveNativeWindow && (mComponentName.startsWith("OMX.google.")
-                || mComponentName.startsWith("OMX.hulk."))) {
+        if (haveNativeWindow && mComponentName.startsWith("OMX.google.")) {
             usingSwRenderer = true;
             haveNativeWindow = false;
             (void)setPortMode(kPortIndexOutput, IOMX::kPortModePresetByteBuffer);
diff --git a/media/libstagefright/MediaCodec.cpp b/media/libstagefright/MediaCodec.cpp
index eee5005..cd1d24b 100644
--- a/media/libstagefright/MediaCodec.cpp
+++ b/media/libstagefright/MediaCodec.cpp
@@ -1989,8 +1989,7 @@ void MediaCodec::onMessageReceived(const sp<AMessage> &msg) {
                     }
 
                     const char *owner = mCodecInfo->getOwnerName();
-                    if ((mComponentName.startsWith("OMX.google.")
-                                || mComponentName.startsWith("OMX.hulk."))
+                    if (mComponentName.startsWith("OMX.google.")
                             && (owner == nullptr || strncmp(owner, "default", 8) == 0)) {
                         mFlags |= kFlagUsesSoftwareRenderer;
                     } else {
-- 
