From aa25ff6fdea2563c34840cc794354ffa90b1068c Mon Sep 17 00:00:00 2001
From: enesuzun2002 <emurat.uzun@gmail.com>
Date: Mon, 2 Nov 2026 18:51:18 +0300
Subject: [PATCH] main: add a PRODUCT_PACKAGES_FILTER hook for device trees

A filter-out of PRODUCT_PACKAGES in a device makefile cannot remove
packages added by inherited product configs, because main.mk installs
from the PRODUCTS.<product>.PRODUCT_PACKAGES union. Filter that list
against PRODUCT_PACKAGES_FILTER.

Change-Id: I47c94493750e7181904b48ea1ba6396fe7d3eaee
---
 core/main.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/main.mk b/core/main.mk
index 97ec295..ab3a7f1 100644
--- a/core/main.mk
+++ b/core/main.mk
@@ -908,6 +908,11 @@ ifdef FULL_BUILD
   # by the appropriate product definition file, which was included
   # by product_config.mk.
   product_MODULES := $(PRODUCTS.$(INTERNAL_PRODUCT).PRODUCT_PACKAGES)
+  # Let a device remove packages that inherited product configs add: the
+  # PRODUCTS.<product>.PRODUCT_PACKAGES union re-adds every inherited file's
+  # packages, so a filter-out in the device makefile cannot. Set
+  # PRODUCT_PACKAGES_FILTER (a plain make variable) in the device makefile.
+  product_MODULES := $(filter-out $(PRODUCT_PACKAGES_FILTER),$(product_MODULES))
 ifdef BOARD_VNDK_VERSION
   product_MODULES += vndk_package
 endif
-- 
