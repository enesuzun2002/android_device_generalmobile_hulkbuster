From 3f734a3046dbea4f802e82f0821ecc4855f5562f Mon Sep 17 00:00:00 2001
From: enesuzun2002 <emurat.uzun@gmail.com>
Date: Tue, 3 Nov 2026 22:20:04 +0300
Subject: [PATCH] camera: device: hide flash modes on cameras without a flash

A shared HAL1 feature table gave the front camera the rear camera's
flash modes. With ro.vendor.camera<id>.no_flash=true advertise and
accept only flash-mode=off, so apps hide the flash control.

Change-Id: I150f812debea83f2782bd7875604868aa671639d
---
 camera/device/1.0/default/CameraDevice.cpp | 28 ++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/camera/device/1.0/default/CameraDevice.cpp b/camera/device/1.0/default/CameraDevice.cpp
index c6585e5..cec7870 100644
--- a/camera/device/1.0/default/CameraDevice.cpp
+++ b/camera/device/1.0/default/CameraDevice.cpp
@@ -1149,6 +1149,28 @@ static std::string limitPictureSizes(const std::string& params, const std::strin
     return out;
 }
 
+/*
+ * Cameras without a flash LED (ro.vendor.camera<id>.no_flash=true) can still
+ * get the flash modes of a shared HAL1 feature table; advertise and accept
+ * only "off" so apps hide the flash control.
+ */
+static bool cameraHasNoFlash(const std::string& cameraId) {
+    char key[64];
+    snprintf(key, sizeof(key), "ro.vendor.camera%s.no_flash", cameraId.c_str());
+    return property_get_bool(key, false);
+}
+
+static std::string forceFlashOff(const std::string& params, const std::string& cameraId) {
+    if (!cameraHasNoFlash(cameraId)) return params;
+    std::string out = params;
+    size_t pos, len;
+    std::string v = getParam(out, "flash-mode-values", &pos, &len);
+    if (!v.empty()) out.replace(pos, len, "off");
+    v = getParam(out, "flash-mode", &pos, &len);
+    if (!v.empty() && v != "off") out.replace(pos, len, "off");
+    return out;
+}
+
 Return<Status> CameraDevice::setParameters(const hidl_string& params) {
     ALOGV("%s(%s)", __FUNCTION__, mCameraId.c_str());
     Mutex::Autolock _l(mLock);
@@ -1157,7 +1179,8 @@ Return<Status> CameraDevice::setParameters(const hidl_string& params) {
         return Status::OPERATION_NOT_SUPPORTED;
     }
     if (mDevice->ops->set_parameters) {
-        std::string limited = limitPictureSizes(std::string(params.c_str()), mCameraId);
+        std::string limited = forceFlashOff(
+                limitPictureSizes(std::string(params.c_str()), mCameraId), mCameraId);
         return getHidlStatus(mDevice->ops->set_parameters(mDevice, limited.c_str()));
     }
     return Status::ILLEGAL_ARGUMENT;
@@ -1174,7 +1197,8 @@ Return<void> CameraDevice::getParameters(getParameters_cb _hidl_cb) {
     }
     if (mDevice->ops->get_parameters) {
         char *temp = mDevice->ops->get_parameters(mDevice);
-        outStr = limitPictureSizes(std::string(temp ? temp : ""), mCameraId);
+        outStr = forceFlashOff(
+                limitPictureSizes(std::string(temp ? temp : ""), mCameraId), mCameraId);
         if (mDevice->ops->put_parameters) {
             mDevice->ops->put_parameters(mDevice, temp);
         } else {
