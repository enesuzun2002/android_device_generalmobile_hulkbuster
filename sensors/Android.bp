// Native android.hardware.sensors@1.0 HIDL service for the MT6592 hulkbuster
// (GM E-Tab5). Talks to the kernel hwmsen framework directly (/dev/hwmsensor
// + the "hwmdata" input node) instead of going through the closed MTK
// sensors.mt6592.so blob, which only reports HAL 1.1 and is rejected by
// Pie's sensors passthrough (needs >= 1.3).
cc_binary {
    name: "android.hardware.sensors@1.0-service.hulkbuster",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.sensors@1.0-service.hulkbuster.rc"],
    srcs: [
        "Sensors.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors@1.0",
        "libbase",
        "libcutils",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libutils",
    ],
}
