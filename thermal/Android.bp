// Native android.hardware.thermal@1.0 HIDL service for the MT6592 hulkbuster
// (GM E-Tab5). Reads the kernel's MTK thermal zones from /sys/class/thermal
// and per-core load from /proc/stat. It only reports temperatures; throttling
// itself stays in the kernel MTK thermal driver.
cc_binary {
    name: "android.hardware.thermal@1.0-service.hulkbuster",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.thermal@1.0-service.hulkbuster.rc"],
    srcs: [
        "Thermal.cpp",
        "ThermalGovernor.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.thermal@1.0",
        "libbase",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libutils",
    ],
}
