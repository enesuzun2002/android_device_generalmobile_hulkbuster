<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Set installation of non market apps on by default -->
    <bool name="def_install_non_market_apps">true</bool>
    <!-- 30 seconds for default screen timeout -->
    <integer name="def_screen_off_timeout">30000</integer>
    <!-- Shorter window/transition animations: the MT6592/Mali-450 renders
         them at full rate but they read as sluggish at 1x. -->
    <fraction name="def_window_animation_scale">75%</fraction>
    <fraction name="def_window_transition_scale">75%</fraction>
</resources>
